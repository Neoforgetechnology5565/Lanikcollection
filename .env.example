# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lanik

# --- App ---
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CRON_SECRET=change-me-random-token

# --- Admin seed (used only by `npm run db:seed`) ---
ADMIN_EMAIL=admin@lanikcollections.com
# Quote the value if it contains "#" (otherwise it is treated as a comment).
ADMIN_PASSWORD="change-me-now"

# --- Flutterwave ---
# FLW_MODE must match your keys: "sandbox" needs FLWSECK_TEST-... keys, "live" needs live keys.
FLW_MODE=sandbox
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
# Must equal the "Secret hash" you set under Flutterwave Dashboard > Settings > Webhooks.
FLW_SECRET_HASH=choose-a-long-random-string
# Sandbox/testing only (ignored/rejected in live mode): point at a local mock of the Flutterwave API.
# FLW_BASE_URL=http://localhost:4010/v3

# Dedicated database for `npm test` (tests refuse to run against DATABASE_URL)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/lanik_test

# --- File storage ---
# local (default) only suits one long-lived server. On serverless hosts use S3-compatible storage and/or Cloudinary.
STORAGE_DRIVER=local
# S3 / Cloudflare R2 / Supabase Storage (S3 API) / MinIO:
# S3_BUCKET=lanik-assets
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS S3
# S3_FORCE_PATH_STYLE=1                                      # needed by some providers (MinIO)
# S3_PUBLIC_BASE_URL=https://cdn.yourdomain.com              # public URL prefix for product images
# Receipts always stay PRIVATE (keep the bucket private; admins read them through /admin).
# Optional: public product images on Cloudinary instead
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Email (pick one; with neither set, mail is recorded in Admin > Emails but not sent) ---
MAIL_FROM="LANIK COLLECTIONS <no-reply@yourdomain.com>"
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_URL=smtps://user:pass@smtp.example.com:465
